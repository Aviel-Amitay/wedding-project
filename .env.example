# ============================================================
#  .env.example  —  TEMPLATE. Commit this file.
#  To set up: copy this file to .env and fill in real values.
#
#  $ cp .env.example .env
#
#  Then run:  bash build.sh   (generates config.js for local dev)
#  On Netlify: set these as Environment Variables in the dashboard
# ============================================================

# Firebase project credentials
# Firebase Console → Project Settings → Your apps → SDK setup → Config
FIREBASE_API_KEY=REPLACE_WITH_YOUR_API_KEY
FIREBASE_AUTH_DOMAIN=REPLACE_WITH_YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=REPLACE_WITH_YOUR_PROJECT.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=REPLACE_WITH_YOUR_APP_ID

# The Google account email that has admin access to admin.html
ADMIN_EMAIL=your-email@gmail.com

# VAPID key for browser push notifications
# Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
VAPID_KEY=REPLACE_WITH_YOUR_VAPID_KEY
